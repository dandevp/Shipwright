# Run with cmake -P. Hashes every file under ASSET_DIR (path and content) into SOH_ASSET_VERSION
# and writes it to OUTPUT, touching OUTPUT only when the hash changes.
#
# Extraction stamps this hash into oot.o2r/oot-mq.o2r, and startup regenerates an archive whose
# stamp differs: an archive extracted from older specs can be missing resources the code now asks
# for (e.g. after an asset rename), which otherwise only shows up as a crash in-game.
# .gitattributes forces LF, so the hash is the same on every platform.

if(NOT ASSET_DIR OR NOT OUTPUT)
    message(FATAL_ERROR "usage: cmake -DASSET_DIR=<dir> -DOUTPUT=<header> -P GenerateAssetVersion.cmake")
endif()

file(GLOB_RECURSE ASSET_FILES RELATIVE ${ASSET_DIR} ${ASSET_DIR}/*)
list(SORT ASSET_FILES)

set(MANIFEST "")
foreach(ASSET_FILE IN LISTS ASSET_FILES)
    file(SHA1 ${ASSET_DIR}/${ASSET_FILE} FILE_HASH)
    string(APPEND MANIFEST "${ASSET_FILE} ${FILE_HASH}\n")
endforeach()
string(SHA1 ASSET_VERSION "${MANIFEST}")

set(CONTENT "#pragma once\n\n// Generated by CMake/GenerateAssetVersion.cmake from soh/assets/yml. Do not edit.\n#define SOH_ASSET_VERSION \"${ASSET_VERSION}\"\n")

if(EXISTS ${OUTPUT})
    file(READ ${OUTPUT} EXISTING)
    if(EXISTING STREQUAL CONTENT)
        return()
    endif()
endif()

file(WRITE ${OUTPUT} "${CONTENT}")
message(STATUS "Asset version: ${ASSET_VERSION}")
